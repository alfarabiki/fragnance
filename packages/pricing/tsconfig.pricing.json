{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../config/tsconfig.react-library.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}