# ----------------------------------------------------------------------------
# ATLASE environment variables
# Copy to .env.local (gitignored). NEVER commit real secrets.
# ----------------------------------------------------------------------------

# --- Storefront + Admin (public) ---
# Required for storefront order persistence AND admin auth.
NEXT_PUBLIC_SUPABASE_URL=https://ecztdymcmzcaffdwhjur.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# --- Server-only (storefront order/payment persistence) ---
# Service role key bypasses RLS; keep server-side only.
SUPABASE_URL=https://ecztdymcmzcaffdwhjur.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Midtrans (server-only) ---
MIDTRANS_SERVER_KEY=<server_key>
MIDTRANS_IS_SANDBOX=true