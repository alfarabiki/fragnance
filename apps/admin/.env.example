# --- Supabase (public, safe for client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# --- Web app cache revalidation (server-only) ---
# Called after every catalog write so the storefront's ISR pages update
# immediately instead of waiting out their 60s revalidate window.
WEB_APP_URL=https://<web-app-domain>
REVALIDATE_SECRET=<shared_secret, same value as web app's REVALIDATE_SECRET>