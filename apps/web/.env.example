# --- Supabase (public, safe for client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# --- QRIS Static → Dynamic (public) ---
# Paste your static QRIS payload string (raw EMVCo TLV, NOT the image)
# Get it from your QRIS provider (GoPay, DANA, etc.)
# Example: 000201010211...5802ID...6304XXXX
NEXT_PUBLIC_QRIS_STATIC_STRING=
# QRIS MDR Rate (optional, defaults to 0.007 = 0.7% for regular merchant)
NEXT_PUBLIC_QRIS_MDR_RATE=

# --- Supabase (server-only, NEVER expose to client) ---
# Used to persist orders / payments as the system of record.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Midtrans (server-only) ---
MIDTRANS_SERVER_KEY=<server_key>
MIDTRANS_IS_SANDBOX=true

# --- Cache revalidation webhook (server-only) ---
# Admin app calls POST /api/revalidate with this as a Bearer token right
# after every catalog write, to bust ISR cache before the natural 60s window.
REVALIDATE_SECRET=<shared_secret, same value as admin app's REVALIDATE_SECRET>